# ─────────────────────────────────────────────────────
# FRONTEND (Next.js) — set in frontend/.env.local for local dev
# or in the Vercel dashboard for production
# ─────────────────────────────────────────────────────

# Local development (points to local FastAPI):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (set this in Vercel dashboard → Settings → Environment Variables):
# NEXT_PUBLIC_API_URL=https://deal-desk-quote-simulator.onrender.com


# ─────────────────────────────────────────────────────
# BACKEND (FastAPI) — set in the Render dashboard for production
# ─────────────────────────────────────────────────────

# Local development (allow the local Next.js dev server):
ALLOWED_ORIGINS=http://localhost:3000

# Production (set this in Render dashboard → Environment → ALLOWED_ORIGINS):
# ALLOWED_ORIGINS=https://deal-desk-quote-simulator.vercel.app

# Multiple origins (comma-separated, no trailing slashes):
# ALLOWED_ORIGINS=http://localhost:3000,https://deal-desk-quote-simulator.vercel.app
